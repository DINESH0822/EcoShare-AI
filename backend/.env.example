# EcoShare AI backend environment template
# Copy this file to .env and fill in the real values for your environment.

PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/ecoshare
JWT_SECRET=replace_with_a_strong_secret
OTP_PROVIDER=development
OTP_API_KEY=
OTP_API_SECRET=

# Optional provider configuration
GEOCODING_PROVIDER=development
ROUTING_PROVIDER=development
GOOGLE_MAPS_API_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional integration placeholders
AI_API_KEY=
EMAIL_API_KEY=
WHATSAPP_API_TOKEN=

# Frontend and CORS settings
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# Python runtime executable (optional, defaults to 'python' on Windows or 'python3' on Linux/Render)
PYTHON_BIN=
